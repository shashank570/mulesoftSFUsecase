  <flow name="accounts-sfdc-papi-api-main">
        <http:listener config-ref="accounts-sfdc-papi-api-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
